# Copy this file to .env.local for local development, then fill in the values.
# Restart the development server after changing them. Never commit real secrets.
# Variables starting with NEXT_PUBLIC_ are exposed to the browser, not private.

# Application
# Public website URL. Currently not read by the application, so changing this
# value alone does not change the site's URLs or deployment domain.
NEXT_PUBLIC_URL="https://webdevamin.com"

# Mail
# Base URL of the administration app, whose transactional email API sends through AWS SES.
# Required by /api/send. The live URL below sends real emails, even from local development.
# This is not a secret; the production value is also set in wrangler.toml.
ADMIN_URL="https://webdevamin.app"

# Private API key created for the Webdevamin product in admin's Integration section.
# Required to authenticate server-to-server email requests. Store it as a Cloudflare
# Worker secret in production. Never expose it in browser code or commit it.
ADMIN_API_KEY=""

# Required receiving inbox for contact-form submissions, e.g. you@example.com.
# There is no default: leaving this empty makes contact-form sending fail.
# This is NOT the sender. The code explicitly sends from hello@mail.webdevamin.com,
# and sets reply-to to the visitor's address so you can answer their enquiry.
# Set this in .env.local locally and in Cloudflare's Worker environment in production.
MAIL_TO=""

# PostHog
# Public PostHog project token from the project's settings, not a personal API key.
# Used for browser analytics after the visitor accepts cookies. Analytics are disabled
# in development by default. NEXT_PUBLIC_ values must be available when building the app.
NEXT_PUBLIC_POSTHOG_KEY=

# EU PostHog ingestion URL, currently kept here for reference only.
# The app uses /ingest, with the EU destination configured in next.config.js;
# changing this variable alone does not change where analytics are sent.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
